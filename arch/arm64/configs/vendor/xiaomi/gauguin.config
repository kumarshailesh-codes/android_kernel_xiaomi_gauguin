# CONFIG_ARM64_ERRATUM_819472 is not set
# CONFIG_ARM64_ERRATUM_832075 is not set
# CONFIG_ARM64_ERRATUM_845719 is not set
# CONFIG_ARM64_ERRATUM_843419 is not set
# CONFIG_ARM64_ERRATUM_858921 is not set
# CONFIG_ARM64_ERRATUM_1024718 is not set
# CONFIG_ARM64_ERRATUM_1188873 is not set
# CONFIG_ARM64_ERRATUM_1463225 is not set
# CONFIG_ARM64_ERRATUM_1542419 is not set
# CONFIG_ARM64_ERRATUM_1742098 is not set
# CONFIG_CAVIUM_ERRATUM_22375 is not set
# CONFIG_CAVIUM_ERRATUM_23154 is not set
# CONFIG_CAVIUM_ERRATUM_27456 is not set
# CONFIG_CAVIUM_ERRATUM_30115 is not set
# CONFIG_FSL_ERRATUM_A008585 is not set
# CONFIG_HISILICON_ERRATUM_161600802 is not set
# CONFIG_HISILICON_ERRATUM_161010101 is not set
# CONFIG_HW_RANDOM_CAVIUM is not set
# CONFIG_QCOM_FALKOR_ERRATUM_1003 is not set
# CONFIG_QCOM_FALKOR_ERRATUM_1009 is not set
# CONFIG_QCOM_FALKOR_ERRATUM_E1041 is not set
# CONFIG_QCOM_QDF2400_ERRATUM_0065 is not set
# CONFIG_SOCIONEXT_SYNQUACER_PREITS is not set

# BT
# CONFIG_BT_BREDR is not set
# CONFIG_BT_LE is not set

# CPU Boost
CONFIG_CPU_BOOST=y
CONFIG_MSM_PERFORMANCE=y

# OEM Power drivers
CONFIG_BATT_VERIFY_BY_DS28E16=y
CONFIG_BQ2597X_CHARGE_PUMP=y
CONFIG_ONEWIRE_GPIO=y

# Touchscreen driver
CONFIG_TOUCHSCREEN_NT36xxx_HOSTDL_SPI=y
# CONFIG_TOUCHSCREEN_FTS is not set

# Fingerprint drivers
CONFIG_INPUT_FINGERPRINT=y
CONFIG_FINGERPRINT_GOODIX=y
CONFIG_FPR_FPC=y

# Netlabel
CONFIG_NETLABEL=y

# PStore configs
CONFIG_PSTORE=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_PMSG=y
CONFIG_PSTORE_RAM=y

# QCACLD
CONFIG_QCA_CLD_WLAN=y

# RmNet
CONFIG_RMNET_PERF=y
CONFIG_RMNET_SHS=y

# IR drivers
CONFIG_RC_CORE=y
CONFIG_LIRC=y
CONFIG_RC_DECODERS=y
CONFIG_RC_DEVICES=y
CONFIG_IR_SPI=y

# exFAT
CONFIG_EXFAT_FS=y

# F2FS Compression
CONFIG_F2FS_FS_COMPRESSION=y
CONFIG_F2FS_FS_LZO=y
CONFIG_F2FS_FS_LZORLE=y
CONFIG_F2FS_FS_LZ4=y
CONFIG_F2FS_FS_LZ4HC=y
CONFIG_F2FS_FS_ZSTD=y

# Unicode
# CONFIG_SDCARD_FS is not set

# Cmdline
CONFIG_CMDLINE="ramoops_memreserve=4M"

# RD
# CONFIG_RD_BZIP2 is not set
# CONFIG_RD_LZMA is not set
CONFIG_RD_LZ4=y

# Serial
CONFIG_SERIAL_MSM_GENI_CONSOLE=y
CONFIG_FASTBOOT_CMD_CTRL_UART=y

# FSA I2C
# CONFIG_QCOM_FSA4480_I2C is not set

# Vibrator
CONFIG_INPUT_AW8624_HAPTIC=y
# CONFIG_LEDS_QPNP_VIBRATOR_LDO is not set

# Final Full Power & Stability Injections
CONFIG_BLK_WBT=y
CONFIG_BLK_WBT_MQ=y
CONFIG_BLK_CGROUP_IOLATENCY=y
# CONFIG_ZSMALLOC_PGTABLE_MAPPING is not supported by this kernel
CONFIG_ZRAM_WRITEBACK=y
CONFIG_EROFS_FS_PCPU_KTHREAD_HIPRI=y
# CONFIG_ARM64_PTR_AUTH is not supported by this kernel
CONFIG_TCP_CONG_ADVANCED=y
CONFIG_TCP_CONG_BBR=y
CONFIG_DEFAULT_TCP_CONG="bbr"
CONFIG_NET_SCH_FQ=y
CONFIG_NET_SCH_CODEL=y
CONFIG_NET_SCH_FQ_CODEL=y
CONFIG_NET_SCH_CAKE=y

# Final Stability & Performance Foundation
CONFIG_CRYPTO_LZ4HC=y
CONFIG_WQ_POWER_EFFICIENT_DEFAULT=y
CONFIG_SCHED_AUTOGROUP=y

# Modern Android Cgroup v2 Support
CONFIG_CGROUPS=y
CONFIG_MEMCG=y
CONFIG_MEMCG_SWAP=y
CONFIG_MEMCG_SWAP_ENABLED=y
CONFIG_MEMCG_KMEM=y
CONFIG_CGROUP_FREEZER=y
CONFIG_CPUSETS=y
CONFIG_CGROUP_CPUACCT=y

# Utilization Clamping (Uclamp) & SchedTune Co-existence
CONFIG_UCLAMP_TASK=y
CONFIG_UCLAMP_BUCKETS_COUNT=5
CONFIG_UCLAMP_TASK_GROUP=y
CONFIG_SCHED_TUNE=y

# Production Performance & Debug Overhead Reductions
# CONFIG_DEBUG_INFO is not set
# CONFIG_SCHEDSTATS is not set
# CONFIG_SLAB_FREELIST_RANDOM is not set
# CONFIG_SLAB_FREELIST_HARDENED is not set
# CONFIG_ZRAM_DEDUP is not set
# CONFIG_QTI_DDR_STATS_LOG is not set
# CONFIG_QTI_RPM_STATS_LOG is not set
# CONFIG_MSM_BOOT_STATS is not set
# CONFIG_QCOM_RUN_QUEUE_STATS is not set
# CONFIG_SCSI_LOGGING is not set
# CONFIG_TTY_PRINTK is not set

# High-resolution scheduler ticks
CONFIG_SCHED_HRTICK=y

# RCU Priority Boosting
CONFIG_RCU_EXPERT=y
CONFIG_RCU_BOOST=y
CONFIG_RCU_BOOST_DELAY=500

# Compiler Aggressive Inlining
CONFIG_OPTIMIZE_INLINING=y

# ZSwap Compressed Swap Cache
CONFIG_FRONTSWAP=y
CONFIG_ZSWAP=y
CONFIG_ZSWAP_COMPRESSOR_DEFAULT="lz4"
CONFIG_ZSWAP_ZPOOL_DEFAULT="zsmalloc"
CONFIG_ZSWAP_WRITEBACK=y

# Huawei Optimized LZ4KD compression for ZRAM
CONFIG_CRYPTO_LZ4KD=y
CONFIG_CPU_IDLE_GOV_TEO=y

# Android UI Frame pacing
CONFIG_HZ_300=y
CONFIG_HZ=300

# ARMv8 Cryptographic Extensions (CE) CRC32 acceleration
CONFIG_CRYPTO_CRC32_ARM64_CE=y

# TCP Westwood+ congestion control for variable cellular/Wi-Fi signals
CONFIG_TCP_CONG_WESTWOOD=y

# Clang Link-Time Optimization (LTO)
CONFIG_LTO=y
CONFIG_LTO_CLANG=y
CONFIG_THINLTO=y
